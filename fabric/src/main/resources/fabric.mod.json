{
  "schemaVersion": 1,
  "id": "shogi",
  "version": "${version}",

  "name": "Shogi",
  "description": "${description}",
  "authors": [
    "BlayTheNinth"
  ],
  "contact": {
    "homepage": "https://balm.twelveiterations.com/",
    "sources": "https://github.com/TwelveIterations/Shogi",
    "issues": "https://github.com/TwelveIterations/Shogi/issues"
  },
  "license": "${license}",
  "icon": "shogi.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "net.blay09.mods.shogi.fabric.FabricShogi"
    ],
    "client": [
      "net.blay09.mods.shogi.fabric.client.FabricShogiClient"
    ]
  },
  "mixins": [
    "shogi.mixins.json",
    "shogi.fabric.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": ">=${minecraft_version}",
    "java": ">=${java_version}"
  },
  "suggests": {
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/VAfZ2Nau6j"
      },
      "badges": ["library"]
    }
  }
}
